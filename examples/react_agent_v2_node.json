        "name": "API caller",
        "displayName": "Fetch Customer Assets",
        "type": "tool",
        "description": "Retrieves all CMDB assets belonging to the confirmed customer.",
        "interrupt": false,
        "next": [
          "Assets_Available_8"
        ],
        "inputParameters": [
          {
            "key": "method",
            "value": "POST",
            "type": "text"
