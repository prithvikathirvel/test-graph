      {
        "node_id": "Plan_With_ReAct_11",
        "name": "Autonomous ReAct Agent v2",
        "displayName": "CMDB ReAct Planner",
        "type": "agent",
        "description": "Uses CMDB schema, customer assets, action definitions, and MCP discovery to produce a validated atomic execution plan without executing changes.",
        "interrupt": false,
        "next": [
          "Plan_Status_12"
        ],
        "inputParameters": [
          {
            "key": "model",
            "value": "llama3",
            "type": "string"
          },
          {
            "key": "user_query",
            "value": "{{user_query}}",
            "type": "string"
          },
          {
            "key": "system_prompt",
            "value": "You are the CMDB planning and validation agent for Customer ID {{customer_id}}. PLAN ONLY; never execute an MCP tool and never claim an action happened. Decompose the request into ordered, atomic sub-tasks. Resolve every target only from the customer's owned assets. Use the ontology to validate labels, properties, and relationships. Use action capabilities to validate each action and its required parameters. Use MCP discovery to prove that an implementation tool exists. Never invent assets, action definitions, server IDs, tool names, arguments, or results. If a required action parameter or target is missing, return clarification_needed with one precise question. If an action is unsupported, return unsupported and explain why.\n\nReturn exactly one JSON object with this schema: {\"status\":\"ready|clarification_needed|no_assets|unsupported\",\"review_html\":\"safe concise HTML for the customer\",\"clarification_question\":\"string\",\"sub_tasks\":[{\"id\":1,\"action\":\"string\",\"ci_type\":\"string\",\"target\":{\"name\":\"string\",\"asset_id\":\"string\"},\"parameters\":{},\"depends_on\":[],\"risk\":\"low|medium|high\"}],\"steps\":[{\"step\":1,\"sub_task_id\":1,\"description\":\"string\",\"server_id\":\"exact discovered server id or empty\",\"tool_name\":\"exact discovered tool name or empty\",\"arguments\":{},\"expected_result\":\"string\"}]}. review_html must list action, resolved target, parameters, dependencies, risk, and proposed tool, and must end by asking for confirmation. Do not wrap JSON in markdown fences.",
            "type": "text"
          },
          {
            "key": "tools",
            "value": [
              {
                "name": "Fetch CMDB Ontology",
                "description": "Fetch the authoritative CMDB ontology in Turtle RDF. Use it to validate CI labels, relationships, and property names.",
                "node_type": "API caller",
                "config": {
                  "method": "GET",
                  "url": "http://1.6.37.35/cmdb/schema?response_type=turtle",
                  "headers": {},
                  "timeout": 15
                }
              },
              {
                "name": "Get Customer Assets",
                "description": "Return only assets owned by the already authenticated customer. Use this to resolve generic references to exact asset names and ids.",
                "node_type": "API caller",
                "config": {
                  "method": "POST",
                  "url": "http://1.6.37.35/cmdb/query",
                  "headers": {
                    "Content-Type": "application/json"
                  },
                  "data": {
                    "query": "MATCH (n)-[:BELONGS_TO]->(:Customer {id: $cust_id}) OPTIONAL MATCH (n)-[r]->(m) WHERE NOT n:ActionDefinition RETURN labels(n) AS labels, properties(n) AS asset, type(r) AS relationship, labels(m) AS related_labels, properties(m) AS related LIMIT 500",
                    "parameters": {
                      "cust_id": "{{customer_id}}"
                    }
                  },
                  "timeout": 20
                }
              },
              {
                "name": "Get Action Capabilities",
                "description": "Fetch allowed CMDB ActionDefinition records and required parameters for one exact CI type.",
                "node_type": "API caller",
                "config": {
                  "method": "POST",
                  "url": "http://1.6.37.35/cmdb/query",
                  "headers": {
                    "Content-Type": "application/json"
                  },
                  "data": {
                    "query": "MATCH (t:Type {name: $ci_type})<-[:APPLIES_TO]-(a:ActionDefinition) RETURN properties(a) AS action",
                    "parameters": {
                      "ci_type": "{{ci_type}}"
                    }
                  },
                  "timeout": 15
                },
                "parameters": [
                  {
                    "name": "ci_type",
                    "type": "string",
                    "required": true,
                    "description": "Exact CI type resolved from the ontology and customer asset."
                  }
                ]
              },
              {
                "name": "Discover Available MCP Tools",
                "description": "List connected MCP servers, exact tool names, descriptions, and input schemas. Use it to map every executable step; this only discovers and does not execute.",
                "node_type": "API caller",
                "config": {
                  "method": "GET",
                  "url": "http://localhost:5000/engine/mcp/tools",
                  "headers": {},
                  "timeout": 15
                }
              }
            ],
            "type": "array"
          },
          {
            "key": "memory_window",
            "value": 12,
            "type": "number"
          },
          {
            "key": "memory_mode",
            "value": "auto",
            "type": "string"
          },
          {
            "key": "memory_context",
            "value": "Confirmed customer_id={{customer_id}}. A non-empty customer asset set was verified before planning.",
            "type": "string"
          },
          {
            "key": "persist_memory",
            "value": true,
            "type": "boolean"
          },
          {
            "key": "max_iterations",
            "value": 10,
            "type": "number"
          },
          {
            "key": "temperature",
            "value": 0,
            "type": "number"
          },
          {
            "key": "response_format",
            "value": "json",
            "type": "string"
          },
          {
            "key": "return_trace",
            "value": true,
            "type": "boolean"
          },
          {
            "key": "fallback_answer",
            "value": "{\"status\":\"unsupported\",\"review_html\":\"<p>I could not build a validated plan. Please provide exact targets and actions.</p>\",\"clarification_question\":\"\",\"sub_tasks\":[],\"steps\":[]}",
            "type": "string"
          }
        ],
        "outputParameters": [
          {
            "key": "output",
            "value": "proposed_plan",
            "type": "object"
          }
        ]
      },
