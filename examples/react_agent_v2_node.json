      {
        "node_id": "Execute_With_ReAct_17",
        "name": "Autonomous ReAct Agent v2",
        "displayName": "Approved CMDB Plan Executor",
        "type": "agent",
        "description": "Executes only the customer-approved plan by discovering and calling exact MCP tools, then reports each result.",
        "interrupt": false,
        "next": [
          "Execution_Status_19"
        ],
        "inputParameters": [
          {
            "key": "model",
            "value": "llama3",
            "type": "string"
          },
          {
            "key": "user_query",
            "value": "Execute this customer-approved plan exactly as written. Do not add actions: {{proposed_plan}}",
            "type": "string"
          },
          {
            "key": "system_prompt",
            "value": "You are the CMDB execution agent for confirmed Customer ID {{customer_id}}. The user has passed the explicit approval gate. Execute ONLY steps present in the approved plan, in dependency order. Before every action, verify the target still belongs to this customer and verify the exact MCP server/tool against fresh discovery. Never substitute another target. Never invent arguments or success. Call Execute Discovered MCP Tool once per executable approved step. Read every result. On TOOL_ERROR, correct arguments and retry once; otherwise mark that step failed and continue only where dependencies permit. Internal or unmapped steps must be reported as skipped, not fabricated. Return concise HTML with an overall status and one row/list item per step containing action, target, tool, and actual result. Clearly distinguish succeeded, failed, and skipped steps.",
            "type": "text"
          },
          {
            "key": "tools",
            "value": [
              {
                "name": "Get Customer Assets",
                "description": "Re-fetch customer-owned assets immediately before execution to verify every approved target still belongs to the authenticated customer.",
                "node_type": "API caller",
                "config": {
                  "method": "POST",
                  "url": "http://1.6.37.35/cmdb/query",
                  "headers": {
                    "Content-Type": "application/json"
                  },
                  "data": {
                    "query": "MATCH (n)-[:BELONGS_TO]->(:Customer {id: $cust_id}) RETURN labels(n) AS labels, properties(n) AS asset LIMIT 500",
                    "parameters": {
                      "cust_id": "{{customer_id}}"
                    }
                  },
                  "timeout": 20
                }
              },
              {
                "name": "Get Action Capabilities",
                "description": "Revalidate that an approved action is still allowed for its CI type and obtain its current required parameter schema.",
                "node_type": "API caller",
                "config": {
                  "method": "POST",
                  "url": "http://1.6.37.35/cmdb/query",
                  "headers": {
                    "Content-Type": "application/json"
                  },
                  "data": {
                    "query": "MATCH (t:Type {name: $ci_type})<-[:APPLIES_TO]-(a:ActionDefinition) RETURN properties(a) AS action",
                    "parameters": {
                      "ci_type": "{{ci_type}}"
                    }
                  },
                  "timeout": 15
                },
                "parameters": [
                  {
                    "name": "ci_type",
                    "type": "string",
                    "required": true,
                    "description": "Exact CI type from the approved sub-task."
                  }
                ]
              },
              {
                "name": "Discover Available MCP Tools",
                "description": "Return currently connected MCP servers, exact tool names, descriptions, and input schemas. Always call before execution.",
                "node_type": "API caller",
                "config": {
                  "method": "GET",
                  "url": "http://localhost:5000/engine/mcp/tools",
                  "headers": {},
                  "timeout": 15
                }
              },
              {
                "name": "Execute Discovered MCP Tool",
                "description": "Execute one exact MCP tool from fresh discovery. Use only for an approved plan step and pass arguments matching its discovered schema.",
                "node_type": "Dynamic MCP Tool",
                "config": {},
                "parameters": [
                  {
                    "name": "server_id",
                    "type": "string",
                    "required": true,
                    "description": "Exact connected MCP server id returned by discovery."
                  },
                  {
                    "name": "tool_name",
                    "type": "string",
                    "required": true,
                    "description": "Exact MCP tool name returned by discovery."
                  },
                  {
                    "name": "arguments",
                    "type": "object",
                    "required": true,
                    "description": "Complete arguments object matching the discovered MCP input schema."
                  }
                ]
              }
            ],
            "type": "array"
          },
          {
            "key": "memory_window",
            "value": 8,
            "type": "number"
          },
          {
            "key": "memory_mode",
            "value": "auto",
            "type": "string"
          },
          {
            "key": "memory_context",
            "value": "Confirmed customer_id={{customer_id}}. This node is reachable only after plan_confirmation=confirm.",
            "type": "string"
          },
          {
            "key": "persist_memory",
            "value": true,
            "type": "boolean"
          },
          {
            "key": "max_iterations",
            "value": 16,
            "type": "number"
          },
          {
            "key": "temperature",
            "value": 0,
            "type": "number"
