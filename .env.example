# MongoDB Configuration
MONGO_URI="mongodb://localhost:27017/"
MONGO_DB_NAME="agent_studio"
MONGO_CHECKPOINTER_COLLECTION_NAME="langgraph_checkpoints"

# API Integration
SCHEMA_API_URL="https://apidev.sifymodernization.digital/ai/api/agent-studio/agent-flow/"
GRAPH_CACHE_TTL_SECONDS=300

# Optional API authentication (enable in production)
AUTH_REQUIRED=false
AGENT_API_KEY="replace-with-a-long-random-secret"
AGENT_API_SCOPES="agent:access,agent:invoke,agent:admin,mcp:access"
AGENT_API_ROLES="service,admin"
AGENT_API_TENANT_ID="your-tenant-id"
AGENT_API_USER_ID="service-account"

# SMTP (Email) Configuration
SMTP_USER="your-email@example.com"
SMTP_PASSWORD="your-app-password"
SMTP_SERVER="smtp.gmail.com"
SMTP_PORT=587

# Google Cloud Platform Configuration
GCP_PROJECT_ID="your-gcp-project-id"
GCP_CREDENTIALS_PATH="service-account.json"
GOOGLE_APPLICATION_CREDENTIALS="service-account.json"

# OpenAI / AI Provider Configuration
OPENAI_API_KEY="your-openai-api-key-here"
OPENAI_BASE_URL="https://your-approved-model-gateway.example/v1"
TAVILY_API_KEY="your-tavily-api-key-here"
SENDGRID_API_KEY="your-sendgrid-api-key-here"

# LangSmith / tracing (optional)
LANGSMITH_TRACING="false"
LANGSMITH_ENDPOINT="https://api.smith.langchain.com"
LANGSMITH_API_KEY="your-langsmith-api-key-here"
LANGSMITH_PROJECT="Agent_Studio"
